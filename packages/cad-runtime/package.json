{
  "name": "@web-cad/cad-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*.ts",
      "default": "./src/shared/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@web-cad/cad-core": "workspace:*",
    "@web-cad/cad-protocol": "workspace:*",
    "@web-cad/agent-adapter": "workspace:*",
    "@web-cad/geometry-worker": "workspace:*",
    "@web-cad/renderer": "workspace:*",
    "@web-cad/renderer-mesh-bridge": "workspace:*",
    "@web-cad/geometry-kernel": "workspace:*"
  }
}
