{
  "name": "@web-cad/agent-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/generate-operation-schemas.mjs --check && tsc -p tsconfig.json",
    "test": "node ../../scripts/generate-operation-schemas.mjs --check && vitest run",
    "typecheck": "node ../../scripts/generate-operation-schemas.mjs --check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@web-cad/cad-core": "workspace:*",
    "@web-cad/cad-protocol": "workspace:*"
  }
}
