{
  "name": "@web-cad/cad-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./full": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./region-policy": {
      "types": "./src/regionPolicy.ts",
      "default": "./src/regionPolicy.ts"
    },
    "./region-source-validation-policy": {
      "types": "./src/regionSourceValidationPolicy.ts",
      "default": "./src/regionSourceValidationPolicy.ts"
    },
    "./preview-projection": {
      "types": "./src/previewProjection.ts",
      "default": "./src/previewProjection.ts"
    }
  },
  "dependencies": {
    "@web-cad/cad-protocol": "workspace:*",
    "@web-cad/sketch-solver": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
