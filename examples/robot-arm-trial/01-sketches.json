        {
          "op": "sketch.create",
          "id": "s_base",
          "name": "100 mm mounting base",
          "plane": "XY"
        },
        {
          "op": "sketch.addRectangle",
          "sketchId": "s_base",
          "id": "e_base",
          "center": [0, 0],
          "width": 100,
          "height": 100
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_base",
          "id": "h_base_0",
          "center": [-40, -40],
          "radius": 2.25
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_base",
          "id": "h_base_1",
          "center": [40, -40],
          "radius": 2.25
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_base",
          "id": "h_base_2",
          "center": [-40, 40],
          "radius": 2.25
