        {
          "op": "sketch.create",
          "id": "s_pin8",
          "name": "8 mm pivot pin",
          "plane": "XZ"
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_pin8",
          "id": "e_pin8",
          "center": [0, 0],
          "radius": 4
        },
        {
          "op": "sketch.create",
          "id": "s_bolt4",
          "name": "4 mm plain fastener shank",
          "plane": "XY"
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_bolt4",
          "id": "e_bolt4",
          "center": [0, 0],
          "radius": 2
        },
        {
          "op": "sketch.create",
          "id": "s_spacer",
          "name": "2 mm pivot clearance spacer",
          "plane": "XZ"
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_spacer",
          "id": "e_spacer",
          "center": [0, 0],
          "radius": 7
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_spacer",
          "id": "h_spacer_0",
          "center": [0, 0],
          "radius": 4.1
        },
        {
          "op": "parameter.create",
          "id": "upper_span",
          "name": "upper_span",
          "value": 160
        },
        {
          "op": "parameter.create",
          "id": "upper_half",
          "name": "upper_half",
          "value": 80
        },
        {
          "op": "parameter.setExpression",
          "id": "upper_half",
          "expression": "upper_span / 2"
        },
        {
          "op": "parameter.create",
          "id": "upper_length",
          "name": "upper_length",
          "value": 190
        },
        {
          "op": "parameter.setExpression",
          "id": "upper_length",
          "expression": "upper_span + 30"
        },
        {
          "op": "parameter.create",
          "id": "gripper_opening",
          "name": "gripper_opening",
          "value": 20
        },
        {
          "op": "sketch.dimension.create",
          "id": "d_upper_length",
          "name": "Upper overall length",
          "sketchId": "s_upper",
          "target": {
            "kind": "entityScalar",
            "entityId": "e_upper",
            "entityKind": "rectangle",
            "role": "width"
          },
          "parameterId": "upper_length"
        },
        {
          "op": "sketch.dimension.create",
          "id": "d_upper_pivot_0",
          "name": "Upper pivot 0",
          "sketchId": "s_upper",
          "target": {
            "kind": "pointPair",
            "primary": {
              "entityId": "e_upper",
              "entityKind": "rectangle",
              "role": "center"
            },
            "secondary": {
              "entityId": "h_upper_0",
              "entityKind": "circle",
              "role": "center"
            },
            "measurement": "horizontal",
            "direction": "negative"
          },
          "parameterId": "upper_half"
        },
        {
          "op": "sketch.dimension.create",
          "id": "d_upper_pivot_1",
          "name": "Upper pivot 1",
          "sketchId": "s_upper",
          "target": {
            "kind": "pointPair",
            "primary": {
              "entityId": "e_upper",
              "entityKind": "rectangle",
              "role": "center"
            },
            "secondary": {
              "entityId": "h_upper_1",
              "entityKind": "circle",
              "role": "center"
            },
            "measurement": "horizontal",
            "direction": "positive"
          },
          "parameterId": "upper_half"
        }
      ]
    }
  }
}
