        {
          "op": "sketch.addCircle",
          "sketchId": "s_base",
          "id": "h_base_3",
          "center": [40, 40],
          "radius": 2.25
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_base",
          "id": "h_base_4",
          "center": [0, 0],
          "radius": 4.1
        },
        {
          "op": "sketch.create",
          "id": "s_yaw",
          "name": "Yaw platter",
          "plane": "XY"
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_yaw",
          "id": "e_yaw",
          "center": [0, 0],
          "radius": 34
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_yaw",
          "id": "h_yaw_0",
          "center": [0, 0],
          "radius": 4.1
        },
        {
          "op": "sketch.addCircle",
          "sketchId": "s_yaw",
          "id": "h_yaw_1",
