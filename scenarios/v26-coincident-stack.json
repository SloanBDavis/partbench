{
  "id": "v26-coincident-stack",
  "kind": "cadops",
  "seed": [
    {
      "op": "sketch.create",
      "id": "sketch_plate",
      "name": "Plate",
      "plane": "XY"
    },
    {
      "op": "sketch.addCircle",
      "sketchId": "sketch_plate",
      "id": "circle_plate",
      "center": [
        0,
        0
      ],
      "radius": 10
    },
    {
      "op": "feature.extrude",
      "id": "feat_plate",
      "bodyId": "body_plate",
      "sketchId": "sketch_plate",
      "entityId": "circle_plate",
      "depth": 20
    },
    {
      "op": "assembly.create",
      "id": "asm_stack",
      "name": "Stack assembly"
    },
    {
      "op": "assembly.instance.insert",
      "id": "inst_base",
      "assemblyId": "asm_stack",
      "name": "Base",
      "definition": {
        "kind": "body",
        "bodyId": "body_plate"
      },
      "transform": {
        "translation": [
          0,
          0,
          0
        ]
      }
    },
    {
      "op": "assembly.instance.insert",
      "id": "inst_top",
      "assemblyId": "asm_stack",
      "name": "Top",
      "definition": {
        "kind": "body",
        "bodyId": "body_plate"
      },
      "transform": {
        "translation": [
          0,
          0,
          50
        ]
      }
    },
    {
      "op": "assembly.mate.create",
      "id": "mate_ground",
      "assemblyId": "asm_stack",
      "name": "Ground",
      "kind": "fixed",
      "instanceId": "inst_base"
    }
  ],
  "steps": [
    {
      "id": "coincident-plane-stack",
      "ops": [
        {
          "op": "assembly.mate.create",
          "id": "mate_stack",
          "assemblyId": "asm_stack",
          "name": "Stack",
          "kind": "coincident",
          "primary": {
            "instanceId": "inst_base",
            "plane": "XY",
            "offset": 20
          },
          "secondary": {
            "instanceId": "inst_top",
            "plane": "XY"
          }
        }
      ],
      "expect": {
        "ops": [
          "assembly.mate.create"
        ],
        "diff": {
          "assemblies": {
            "matesCreated": [
              {
                "id": "mate_stack",
                "assemblyId": "asm_stack",
                "name": "Stack",
                "kind": "coincident",
                "primary": {
                  "instanceId": "inst_base",
                  "plane": "XY",
                  "offset": 20
                },
                "secondary": {
                  "instanceId": "inst_top",
                  "plane": "XY"
                }
              }
            ]
          }
        }
      },
      "queries": [
        {
          "query": {
            "query": "project.structure"
          },
          "expect": {
            "ok": true,
            "query": "project.structure",
            "bodyCount": 1,
            "assemblies": [
              {
                "id": "asm_stack",
                "instances": [
                  {
                    "id": "inst_base",
                    "definition": {
                      "kind": "body",
                      "bodyId": "body_plate"
                    },
                    "transform": {
                      "translation": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "id": "inst_top",
                    "definition": {
                      "kind": "body",
                      "bodyId": "body_plate"
                    },
                    "transform": {
                      "translation": [
                        0,
                        0,
                        20
                      ]
                    }
                  }
                ],
                "mates": [
                  {
                    "id": "mate_ground",
                    "kind": "fixed",
                    "instanceId": "inst_base"
                  },
                  {
                    "id": "mate_stack",
                    "kind": "coincident",
                    "primary": {
                      "instanceId": "inst_base",
                      "plane": "XY",
                      "offset": 20
                    },
                    "secondary": {
                      "instanceId": "inst_top",
                      "plane": "XY"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "persist-coincident-stack",
      "persistRoundTrip": true,
      "expect": {
        "schemaVersionNot": [
          "web-cad.project.v23",
          "web-cad.project.v26"
        ]
      },
      "queries": [
        {
          "query": {
            "query": "project.structure"
          },
          "expect": {
            "ok": true,
            "assemblies": [
              {
                "id": "asm_stack",
                "instances": [
                  {
                    "id": "inst_base",
                    "transform": {
                      "translation": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "id": "inst_top",
                    "transform": {
                      "translation": [
                        0,
                        0,
                        20
                      ]
                    }
                  }
                ],
                "mates": [
                  {
                    "id": "mate_ground",
                    "kind": "fixed"
                  },
                  {
                    "id": "mate_stack",
                    "kind": "coincident"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "use": [
    {
      "wait": "[data-action-id=\"solid.coincident-mate\"]"
    },
    {
      "click": "[data-action-id=\"solid.coincident-mate\"]"
    },
    {
      "wait": "#solid-coincident-mate-primary-instance"
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-assembly",
        "option": "asm_stack"
      }
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-primary-instance",
        "option": "inst_base"
      }
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-primary-plane",
        "option": "XY"
      }
    },
    {
      "type": {
        "selector": "#solid-coincident-mate-primary-offset",
        "text": "20"
      }
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-secondary-instance",
        "option": "inst_top"
      }
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-secondary-plane",
        "option": "XY"
      }
    },
    {
      "apply": true
    },
    {
      "waitReady": true
    },
    {
      "screenshot": "v26-coincident-stack-use"
    }
  ],
  "useBreak": [
    {
      "wait": "[data-action-id=\"solid.coincident-mate\"]"
    },
    {
      "click": "[data-action-id=\"solid.coincident-mate\"]"
    },
    {
      "wait": "#solid-coincident-mate-primary-instance"
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-assembly",
        "option": "asm_stack"
      }
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-primary-instance",
        "option": "inst_base"
      }
    },
    {
      "select": {
        "selector": "#solid-coincident-mate-secondary-instance",
        "option": "Select instance"
      }
    },
    {
      "expectDisabled": "[data-ui-smoke=\"apply\"]"
    },
    {
      "screenshot": "v26-coincident-stack-use-break"
    }
  ],
  "useExpect": {
    "forbidClicks": [
      "solid.box"
    ],
    "assemblies": [
      {
        "id": "asm_stack",
        "mates": [
          {
            "kind": "fixed",
            "instanceId": "inst_base"
          },
          {
            "kind": "coincident",
            "primary": {
              "instanceId": "inst_base",
              "plane": "XY",
              "offset": 20
            },
            "secondary": {
              "instanceId": "inst_top",
              "plane": "XY"
            }
          }
        ]
      }
    ]
  }
}
