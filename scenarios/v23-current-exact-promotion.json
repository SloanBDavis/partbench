        "anchorOmitsStableId": true,
        "diff": {
          "references": {
            "topologyCheckpointsCreated": [
              { "checkpointId": "checkpoint_promoted" }
            ],
            "topologyAnchorsCreated": [{ "anchorId": "anchor_promoted" }]
          }
        }
      }
    },
    {
      "id": "vertex-inspect-only",
      "kind": "vertex",
      "query": {
        "query": "selection.referenceCandidates",
        "requiredOperation": "feature.chamfer"
      },
      "expectQuery": {
        "status": "non-commandable",
        "currentTopology": { "outcome": "inspectOnly" },
        "candidateCount": 0
