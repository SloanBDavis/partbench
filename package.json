{
  "name": "partbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @web-cad/web dev",
    "build": "MALLOC_ARENA_MAX=2 pnpm -r build",
    "build:geometry-worker": "MALLOC_ARENA_MAX=2 pnpm --filter @web-cad/web build:geometry-worker",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm test:e2e",
    "typecheck": "pnpm -r typecheck",
    "smoke:ui": "bun scripts/smoke-ui.mjs",
    "smoke:ui-use": "bun scripts/smoke-ui-use.mjs",
    "verify": "pnpm typecheck && pnpm test:e2e",
    "smoke:e2e": "pnpm test:e2e",
    "smoke:agent-runtime": "pnpm --filter @web-cad/mcp-stdio-server build && node scripts/smoke-agent-runtime.mjs",
    "benchmark:cad-runtime": "node scripts/benchmark-cad-runtime.mjs",
    "smoke:agent-runtime:browser": "bun scripts/smoke-ui-use.mjs -- examples/agent-runtime/browser-use.json",
    "smoke:robot-arm": "pnpm --filter @web-cad/mcp-stdio-server build && node scripts/smoke-robot-arm.mjs",
    "smoke:robot-arm:browser": "bun scripts/smoke-ui-use.mjs -- scenarios/robot-arm-revision.json examples/robot-arm-workflow/browser-use.json",
    "smoke:gearbox": "pnpm --filter @web-cad/mcp-stdio-server build && node scripts/smoke-gearbox.mjs",
    "smoke:gearbox:browser": "bun scripts/smoke-ui-use.mjs -- examples/gearbox-workflow/browser-use.json",
    "smoke:interchange": "node scripts/e2e.mjs interchange",
    "smoke:interchange:browser": "node scripts/e2e.mjs interchange",
    "smoke:engine-interchange": "node scripts/smoke-editable-interchange.mjs",
    "smoke:engine-interchange:browser": "bun scripts/smoke-ui-use.mjs -- examples/editable-interchange/engine-browser-use.json",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "@types/node": "^24.0.0"
  }
}
